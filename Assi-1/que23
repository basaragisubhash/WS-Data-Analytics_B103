month = int(input("Enter month number: "))
year = int(input("Enter year: "))

if month < 1 or month > 12:
    print("Invalid Month")

elif month == 2:
    if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0):
        print("29 Days")
    else:
        print("28 Days")

elif month in [4, 6, 9, 11]:
    print("30 Days")

else:
    print("31 Days")