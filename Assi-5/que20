arr = [100, 4, 200, 1, 3, 2]

numbers = set(arr)

longest = 0

for num in numbers:

    if num - 1 not in numbers:

        current = num
        count = 1

        while current + 1 in numbers:
            current += 1
            count += 1

        if count > longest:
            longest = count

print("Longest consecutive sequence:", longest)