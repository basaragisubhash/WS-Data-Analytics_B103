str1 = "listen"
str2 = "silent"

if len(str1) != len(str2):
    print("Not Anagrams")
else:
    count = {}

    for char in str1:
        count[char] = count.get(char, 0) + 1

    for char in str2:
        if char not in count:
            print("Not Anagrams")
            break

        count[char] -= 1

        if count[char] < 0:
            print("Not Anagrams")
            break
    else:
        print("Anagrams")