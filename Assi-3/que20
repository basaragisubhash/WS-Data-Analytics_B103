def count_letters(text):

    vowels = 0
    consonants = 0

    for char in text.lower():

        if char in "aeiou":
            vowels += 1

        elif char.isalpha():
            consonants += 1

    return vowels, consonants


text = input("Enter a string: ")

v, c = count_letters(text)

print("Vowels:", v)
print("Consonants:", c)