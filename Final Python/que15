str1 = input("Enter first string: ")
str2 = input("Enter second string: ")

str1 = str1.lower()
str2 = str2.lower()

if len(str1) != len(str2):
    print("Not Anagram")
else:
    for ch in str1:
        if str1.count(ch) != str2.count(ch):
            print("Not Anagram")
            break
    else:
        print("Anagram")