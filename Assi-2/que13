def grade(marks):

    if marks >= 90:
        return "A"

    elif marks >= 80:
        return "B"

    elif marks >= 70:
        return "C"

    elif marks >= 60:
        return "D"

    else:
        return "F"


print(grade(95))
print(grade(85))
print(grade(75))
print(grade(65))
print(grade(40))